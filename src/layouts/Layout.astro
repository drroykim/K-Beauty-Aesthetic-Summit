---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "KBAS 2026 — K-Beauty Global Aesthetic Summit", 
	description = "North America's Premier Medical Bridge to Korean Aesthetic Innovation. Bridging Gangnam surgical protocols, EBD breakthroughs, and structural deep plane techniques." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-stone-50 text-stone-900 antialiased selection:bg-rose-100 selection:text-rose-900 font-sans">
		<slot />
	</body>
</html>

<style is:global>
	@import '../styles/global.css';

	body {
		font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	.font-serif-title {
		font-family: 'Playfair Display', Georgia, serif;
	}

	.bg-mesh {
		background: radial-gradient(circle at 15% 15%, rgba(244, 238, 230, 0.8) 0%, transparent 40%),
					radial-gradient(circle at 85% 85%, rgba(230, 240, 245, 0.6) 0%, transparent 40%),
					#FAFAF9;
	}

	.glass-nav {
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(229, 231, 235, 0.7);
	}

	/* Fix Squarespace exported images to be visible without Squarespace client JS */
	.sqs-block-image img,
	.fluid-image-container img,
	.image-block img,
	.js-content-mode-element img,
	[data-load="false"],
	img[data-src] {
		opacity: 1 !important;
		visibility: visible !important;
	}

	.sqs-image-shape-container-element,
	.fluid-image-container,
	.content-fill,
	.content-fit {
		position: relative !important;
		width: 100% !important;
		height: 100% !important;
	}

	.sqs-block-image img {
		position: relative !important;
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
	}
</style>
